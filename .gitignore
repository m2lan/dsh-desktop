# Node / npm
node_modules/
# Only the repo's own lockfile is ignored; scripts/kernel-lock/ is committed on
# purpose so the baked dsh kernel tree is reproducible.
/package-lock.json

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Runtime staging (portable node fetched by CI)
runtime-staging/
src-tauri/node-runtime/
# Bundled kernel is baked at release time; don't commit the huge dir
src-tauri/resources/kernel/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
# Local diagnostic captures (machine paths and temporary user homes)
/diagnostics/
# Agent workspace memory (local only, machine-specific)
.workbuddy-ai/
